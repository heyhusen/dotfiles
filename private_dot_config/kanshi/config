output "AU Optronics 0x459D Unknown" {
  mode 1920x1200@60
  position 0,0
  scale 1
  alias $PERSONAL_INTERNAL
}

output "SKYDATA S.P.A. H24G30Q Unknown" {
  mode 2560x1440@60
  position 0,0
  scale 1
  alias $PERSONAL_EXTERNAL
}

profile personal {
    output $PERSONAL_INTERNAL enable
}

profile personal_docked {
    output $PERSONAL_INTERNAL disable
    output $PERSONAL_EXTERNAL enable
}
